rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================================
       🔐 Helper Functions
       ================================ */
    function isSignedIn() {
      return request.auth != null;
    }

    /* ================================
       👤 USERS (Database Records)
       ================================ */
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      /* ---- Results (CBT Tests) ---- */
      match /results/{resultId} {
        allow read, write: if true;
      }
    }

    /* ================================
       📘 SUBJECTS & CBT QUESTIONS
       ================================ */
    match /subjects/{subjectId} {
      allow read, write: if true;

      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    /* ================================
       📝 TASKS
       ================================ */
    match /task/{taskId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    /* ================================
       📝 TESTS
       ================================ */
    match /tests/{testId} {
      allow read, write: if true;
    }

    /* ================================
       🌐 COMMUNITIES
       ================================ */
    match /communities/{communityId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    /* ================================
       💬 PRIVATE CHATS
       ================================ */
    match /privateChats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    /* ================================
       📥 REQUESTS
       ================================ */
    match /requests/{requestId} {
      allow read, write: if true;
    }

    /* ================================
       💳 PAYMENTS
       ================================ */
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if false;
    }

    /* ================================
       🎓 CLASSES
       ================================ */
    match /classes/{token} {
      allow read: if true;
      allow write: if false;
    }

    /* ================================
       🎥 LIVE VIDEO CLASSES & ROOMS
       ================================ */
    match /live_classes/{classId} {
      allow read, write: if true;
    }

    match /live_rooms/{roomCode}/{document=**} {
      allow read, write: if true;
    }

    /* ================================
       🎓 STUDENT PROFILES, SESSIONS & LEARNING TASKS
       ================================ */
    match /student_profiles/{profileId} {
      allow read, write: if true;
    }

    match /tutor_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /learning_tasks/{taskId} {
      allow read, write: if true;
    }

    /* ================================
       📨 LEGACY MESSAGES
       ================================ */
    match /messages/{messageId} {
      allow read, write: if true;
    }
  }
}
